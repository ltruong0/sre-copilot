      "description": "Check if host is reachable",
      "vars": {
        "target_hosts": {"type": "string", "required": true, "description": "Host or group"}
      }
    },
    {
      "name": "check_security",
      "playbook": "check_security_vulnerabilities.yml",
      "description": "Scan for CVEs and missing security patches",
      "vars": {
        "target_hosts": {"type": "string", "required": true, "description": "Host or group"}
